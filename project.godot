[application]

config_version=5

[application/config/name]
value="Compagnie 3D 🐱"

[application/config/features]
value=PackedStringArray("3d")

[application/run/low_processor_mode]
value=true

[display]

[display/window/size/viewport_width]
value=720

[display/window/size/viewport_height]
value=1280

[display/window/size/resizable]
value=false

[display/window/stretch/mode]
value="viewport"

[rendering]

[rendering/renderer/rendering_method]
value="gl_compatibility"

[rendering/renderer/rendering_method.mobile]
value="gl_compatibility"

[rendering/environment/default_environment]
value="res://environment.tres"

[export]

[export/android]
debug=false
package_name="com.compagnie3d.app"
version_code=1
version_name="1.0.0"
min_sdk=26
target_sdk=34
